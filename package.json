{
  "name": "novi-dom",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @novi-dom/frontend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @novi-dom/backend db:generate",
    "db:migrate": "pnpm --filter @novi-dom/backend db:migrate",
    "db:seed": "pnpm --filter @novi-dom/backend db:seed",
    "db:studio": "pnpm --filter @novi-dom/backend db:studio"
  }
}
