# Kopiraj v .env (cp .env.example .env) in po potrebi prilagodi.

# PostgreSQL iz docker-compose.yml
DATABASE_URL="postgresql://novidom:novidom@localhost:5432/novidom?schema=public"

# Auth.js – skrivnost za podpis JWT (ustvari z: openssl rand -base64 32)
AUTH_SECRET="zamenjaj-me"

# Javni naslov aplikacije
APP_URL="http://localhost:3000"

# Podatki zavetišča, prikazani posvojitelju (npr. naslov ogleda)
# SHELTER_NAME="Zavetišče Novi dom"
# SHELTER_ADDRESS="Tačkova ulica 1, 1000 Ljubljana"

# Mapa za naložene fotografije, relativno na koren repozitorija (privzeto uploads)
# UPLOAD_DIR="uploads"

# SMTP – lokalno Mailpit (UI na http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="Novi dom <noreply@novidom.local>"
