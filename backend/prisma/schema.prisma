// Shema podatkovnega modela (docs/03-podatkovni-model.md).
// Modeli se dodajajo z nalogami posameznih uporabniških zgodb.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Uporabniki
// ---------------------------------------------------------------------------

enum Role {
  ADOPTER // posvojitelj
  VOLUNTEER // prostovoljec
  MANAGER // vodja zavetišča
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  animalsCreated Animal[]           @relation("AnimalCreatedBy")
  household      Household?
  applications   Application[]
  events         ApplicationEvent[]
  visitSlots     VisitSlot[]
  visitReports   VisitReport[]
}

// ---------------------------------------------------------------------------
// Vprašalnik o gospodinjstvu (1 : 0..1 z uporabnikom z vlogo ADOPTER)
// ---------------------------------------------------------------------------

enum HousingType {
  APARTMENT // stanovanje
  HOUSE // hiša
}

model Household {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @unique @db.Uuid
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  housingType      HousingType
  hasGarden        Boolean
  // Starosti otrok v letih. Namesto števil otrok pod/nad 6 let, ker opozorilo
  // ujemanja navede starost otroka (»otrok, star 4 leta«, US-03 AC 4).
  childrenAges     Int[]       @default([])
  hasDogs          Boolean     @default(false)
  hasCats          Boolean     @default(false)
  hoursAlonePerDay Int
  experience       String      @default("")
  updatedAt        DateTime    @updatedAt
}

// ---------------------------------------------------------------------------
// Vloga za posvojitev
// ---------------------------------------------------------------------------

// Stanja vloge (docs/02-funkcionalnosti-in-obseg.md, ADR-0006).
// Aktivna stanja: SUBMITTED, IN_REVIEW, VISIT_SCHEDULED, VISIT_DONE, APPROVED.
enum ApplicationStatus {
  SUBMITTED // oddana
  IN_REVIEW // v pregledu
  VISIT_SCHEDULED // ogled dogovorjen
  VISIT_DONE // ogled opravljen
  APPROVED // odobrena
  REJECTED // zavrnjena
  WITHDRAWN // umaknjena
  ADOPTED // posvojena
}

enum MatchLevel {
  MATCH // ujemanje
  CONDITIONAL // pogojno
  MISMATCH // neujemanje
}

// Delna unikatna indeksa (ročna SQL migracija, ker ju Prisma shema ne izrazi):
// - application_one_active_per_adopter_animal: ena aktivna vloga posvojitelja na žival
// - application_one_approved_per_animal: največ ena odobrena vloga na žival
model Application {
  id                String            @id @default(uuid()) @db.Uuid
  adopterId         String            @db.Uuid
  adopter           User              @relation(fields: [adopterId], references: [id])
  animalId          String            @db.Uuid
  animal            Animal            @relation(fields: [animalId], references: [id])
  status            ApplicationStatus @default(SUBMITTED)
  motivation        String
  // Kopija vprašalnika ob oddaji (ADR-0008); kasnejše spremembe profila ne spremenijo vloge.
  householdSnapshot Json
  matchLevel        MatchLevel
  matchWarnings     Json              @default("[]") // seznam opozoril ocene ujemanja
  decisionComment   String?
  submittedAt       DateTime          @default(now())
  closedAt          DateTime? // čas prehoda v končno stanje

  events ApplicationEvent[]
  visits Visit[]

  @@index([adopterId, status])
  @@index([animalId, status])
}

// ---------------------------------------------------------------------------
// Živali
// ---------------------------------------------------------------------------

enum Species {
  DOG
  CAT
}

enum Sex {
  MALE
  FEMALE
}

enum AnimalSize {
  SMALL
  MEDIUM
  LARGE
}

enum EnergyLevel {
  LOW
  MEDIUM
  HIGH
}

// Primernost za otroke: OVER_6 = primerna le za otroke, starejše od 6 let.
enum KidsCompatibility {
  YES
  OVER_6
  NO
  UNKNOWN
}

enum Compatibility {
  YES
  NO
  UNKNOWN
}

// INTAKE = sprejeta, AVAILABLE = na voljo, RESERVED = rezervirana, ADOPTED = posvojena.
// RESERVED in ADOPTED žival dobi le prek odobritve vloge oziroma zaključka posvojitve (US-01 AC 4).
enum AnimalStatus {
  INTAKE
  AVAILABLE
  RESERVED
  ADOPTED
}

model Animal {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  species         Species
  sex             Sex
  birthDateApprox DateTime @db.Date
  description     String   @default("")
  internalNotes   String   @default("") // vedenjske opombe, vidne samo osebju

  // Vedenjske lastnosti. Ob sprejemu so lahko še neznane (null = ni vneseno);
  // žival je mogoče označiti kot na voljo šele, ko nobena ni null (US-01 AC 2).
  // Vrednost UNKNOWN velja kot izpolnjena.
  size         AnimalSize?
  energyLevel  EnergyLevel?
  needsGarden  Boolean?
  goodWithKids KidsCompatibility?
  goodWithDogs Compatibility?
  goodWithCats Compatibility?

  // Osnovne oznake (ni veterinarska kartoteka).
  isChipped    Boolean @default(false)
  isVaccinated Boolean @default(false)
  isNeutered   Boolean @default(false)

  status      AnimalStatus @default(INTAKE)
  intakeDate  DateTime     @default(now()) @db.Date
  createdById String       @db.Uuid
  createdBy   User         @relation("AnimalCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  photos       AnimalPhoto[]
  applications Application[]

  @@index([status, species])
}

model AnimalPhoto {
  id        String @id @default(uuid()) @db.Uuid
  animalId  String @db.Uuid
  animal    Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int    @default(0) // najnižja je naslovna fotografija

  @@index([animalId, sortOrder])
}

// Revizijska sled prehodov vloge (ADR-0007). Samo vstavljanje: sprožilec v bazi
// prepreči UPDATE in DELETE, servisni sloj pa ponuja le zapis in branje.
model ApplicationEvent {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  fromStatus    ApplicationStatus? // null ob oddaji
  toStatus      ApplicationStatus
  actorId       String?            @db.Uuid // null = sistemska sprememba (npr. samodejna zavrnitev)
  actor         User?              @relation(fields: [actorId], references: [id], onDelete: Restrict)
  comment       String?
  createdAt     DateTime           @default(now())

  @@index([applicationId, createdAt])
}

// ---------------------------------------------------------------------------
// Termini in ogledi (US-05)
// ---------------------------------------------------------------------------

// Termin ogleda, ki ga izvede dodeljeni prostovoljec. Časi so v UTC, prikazani
// v času Europe/Ljubljana.
model VisitSlot {
  id          String   @id @default(uuid()) @db.Uuid
  startsAt    DateTime
  endsAt      DateTime
  volunteerId String   @db.Uuid
  volunteer   User     @relation(fields: [volunteerId], references: [id])
  isCancelled Boolean  @default(false) // npr. zaprto zavetišče
  createdAt   DateTime @default(now())

  visits Visit[]

  @@index([startsAt])
  @@index([volunteerId, startsAt])
}

enum VisitOutcome {
  PENDING // dogovorjen, še ni izveden
  DONE // opravljen (zapisnik oddan)
  NO_SHOW // kandidat ni prišel
  CANCELLED // odpovedan
}

// Rezervacija termina za vlogo. Delna unikatna indeksa (ročna SQL migracija):
// - visit_one_active_per_slot: termin je zaseden z največ enim neodpovedanim ogledom
// - visit_one_pending_per_application: vloga ima največ en dogovorjen ogled
model Visit {
  id            String       @id @default(uuid()) @db.Uuid
  applicationId String       @db.Uuid
  application   Application  @relation(fields: [applicationId], references: [id])
  slotId        String       @db.Uuid
  slot          VisitSlot    @relation(fields: [slotId], references: [id])
  outcome       VisitOutcome @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  report VisitReport?

  @@index([applicationId])
  @@index([slotId])
}

// ---------------------------------------------------------------------------
// Zapisnik ogleda (US-06)
// ---------------------------------------------------------------------------

enum Recommendation {
  RECOMMEND // priporočam
  WITH_RESERVATIONS // s pridržki
  NOT_RECOMMEND // ne priporočam
}

// Zapisnik prostovoljca po ogledu (1 : 0..1 z ogledom). Viden je vodji, posvojitelju nikoli
// (US-06 AC 5). Prostovoljec ga lahko ureja 24 ur po oddaji (submittedAt), nato je samo za branje.
model VisitReport {
  id             String         @id @default(uuid()) @db.Uuid
  visitId        String         @unique @db.Uuid
  visit          Visit          @relation(fields: [visitId], references: [id])
  authorId       String         @db.Uuid
  author         User           @relation(fields: [authorId], references: [id])
  recommendation Recommendation
  text           String
  submittedAt    DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}
